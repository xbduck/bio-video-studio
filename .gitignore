# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 系统文件
.DS_Store
Thumbs.db

# 运行日志 / 任务队列状态
logs/
*.log
tasks/queue.jsonl

# 生成的媒体产物（约 1GB：图片/视频/音频/字幕/成片，属运行时输出，不入库）
# 仅保留 projects/_index.json、projects/<人物>/project.json、script.json 等文本元数据
projects/*/audio/
projects/*/clips/
projects/*/images/
projects/*/output/
projects/*/subs/
projects/*/videos/
projects/*/videos_ai/
projects/*/bgm.mp3

# HyperFrames 中间产物：assets/bg.png 是 images/ 的拷贝，只保留 index.html 模板入库
projects/*/hf/*/assets/
